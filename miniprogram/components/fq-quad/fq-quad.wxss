/* components/fq-quad/fq-quad.wxss
   总览 2×2 满色矩阵
   规则原在 pages/index/index.wxss 里，整段搬来。此后只补了一条「自适应高度」
   （fill 属性，总览页一屏装满用），其余一字未改。
   共享资产（自绘图标 .ico-* / 象限图标 .qmark / 按钮 .btn*）留在 app.wxss，
   靠 styleIsolation: apply-shared 生效 —— 所以这里只有本组件自己的骨架。
   ============================================================== */

/* ---------------- 四象限矩阵 ---------------- */

/* 四象限矩阵：两列严格等宽。
   ⚠️ 不要用 grid 的 `1fr 1fr`：1fr 等价于 minmax(auto, 1fr)，这个 auto 下限取
   内容的 min-content，而 .gi .tx 是 white-space:nowrap，长标题会把所在列顶宽。
   实测就是这样：左列 215px / 右列 275px（右列被 q4 的长标题撑开），且整体溢出 0.5px。
   改用 flex：基准固定 50% - 7rpx，两列合计恰好留出 14rpx 列间距。
   间距用 margin 而非 flex gap（旧 Android WebView 对 gap 支持不稳）。 */
.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;   /* 两列分别贴齐左右边距，中间自动留出 14rpx */
}

/* 尺寸恒定：宽 = 50% - 7rpx（两列 + 14rpx 间距 = 100%，不会换行），高 476rpx。
   ⚠️ 高度只在 fill=false 时是 476rpx；总览页传了 fill，改由容器均分（见下方「自适应高度」）。
   注意全局 box-sizing 是 border-box（app.wxss 里统一设的），476rpx 已包含上下 padding。
   min-width:0 是必须的：不清掉 flex 的 min-width:auto，长标题照样能把这一块顶宽，
   等分立刻失效。flex 的 0 0 保证「不放大、不收缩」。 */
.q {
  flex: 0 0 calc(50% - 7rpx);
  min-width: 0;
  height: 476rpx;
  margin-bottom: 14rpx;
  padding: 26rpx 24rpx 22rpx;
  background: var(--qc);
  color: #fff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  position: relative;
  text-align: left;
}

/* 第二行：不再留底边距，避免矩阵下方多出一截空隙 */
.q.nb {
  margin-bottom: 0;
}

/* ---------------- 自适应高度（总览页专用，配合 fill 属性） ----------------
   总览页要把「矩阵 + 饮水卡」叠在一屏里，两块高度都不能写死 ——
   写死就必然在小屏溢出（多出一条可滚动的尾巴）、在大屏留白。
   做法与宽度同源：.grid 撑满宿主给的高度，两块按容器均分
        高 = 50% - 7rpx
   两行 + 中间 14rpx 恰好 = 100%，所以横竖都严格等分。

   ⚠️ 百分比高度要求 .grid 的高度是**确定的**：宿主必须给它一个算得出来的高
      （flex:1、固定高都行）。宿主没给 → calc(50%) 退化成 auto，两块回到
      内容高，矩阵会缩成一条 —— 页面侧因此用 .ovgrid { flex:1 } 兜住它。 */
.grid.fill {
  height: 100%;
}

.grid.fill .q {
  height: calc(50% - 7rpx);
}

/* 极矮屏（如 667pt 的老 SE）上，某格若有 3 行（2 条 + 「还有 N 项」），
   自适应高度可能不够装。此时让列表**就地收缩并裁掉**，而不是画到卡片外面
   —— 后者会盖住下面那张卡片，看起来像样式坏了。
   flex-shrink 只在空间不足时才生效：常规机型上 .qlist 拿到的是 auto 外边距，
   高度按内容，不受这条影响。 */
.grid.fill .qlist {
  flex-shrink: 1;
  min-height: 0;
  overflow: hidden;
}

/* 外角 24px、内角 12px：四块拼合后整体轮廓是 24px 圆角矩形，中心缝隙成十字 */
.q.q1 { border-radius: 48rpx 24rpx 24rpx 24rpx; }
.q.q2 { border-radius: 24rpx 48rpx 24rpx 24rpx; }
.q.q3 { border-radius: 24rpx 24rpx 24rpx 48rpx; }
.q.q4 { border-radius: 24rpx 24rpx 48rpx 24rpx; }

/* 点击反馈只用「不改变尺寸」的方式。
   早期用的 transform: scale(0.975) 会让象限看起来缩水，与「四块恒定等大」冲突。 */
.q:active {
  opacity: 0.9;
}

/* 象限内部三块不参与压缩：内容多时也不许把标题和数字挤扁 */
.qtop,
.qnum,
.qlist {
  flex-shrink: 0;
}

.qtop {
  display: flex;
  flex-direction: column;
}

.qname {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.01em;
}

.qhint {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.06em;
  color: #fff;
  margin-top: 6rpx;
}

/* ---------------- 象限卡片的标题行 ----------------
   图标 + 象限名的横向排布。图标本体（白圆底 + 同象限色字形）是**共享资产**，
   定义在 app.wxss 的「共享视觉资产」段 —— 总览矩阵与详情头部共用同一个 .qmark，
   各自只负责自己的间距。
   字形靠**复合类**选（.qmark.q1），所以 WXML 里要把象限键挂在图标元素上：
     <view class="qmark {{item.key}}"></view> */
.qrow {
  display: flex;
  align-items: center;
}

.qrow .qname {
  flex: 1 1 auto;
  min-width: 0;   /* 不清掉 min-width:auto，长名字会把图标挤出卡片 */
}


.qrow .qmark {
  margin-right: 16rpx;
}

.qnum {
  font-size: 60rpx;
  font-weight: 600;
  line-height: 1;
  letter-spacing: -0.03em;
  margin-top: 20rpx;
  font-variant-numeric: tabular-nums;
}

.qlist {
  margin-top: auto;
  padding-top: 20rpx;
}

.gi {
  display: flex;
  align-items: flex-start;
  font-size: 23rpx;
  line-height: 1.4;
  color: #fff;
  margin-bottom: 10rpx;
}

.gi:last-child {
  margin-bottom: 0;
}

.gi .dot {
  flex: 0 0 6rpx;
  width: 6rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #fff;
  margin-top: 12rpx;
  margin-right: 12rpx;
}

.gi .tx {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.gempty {
  font-size: 23rpx;
  line-height: 1.5;
  color: #fff;
  opacity: 0.92;
}

.gempty .s {
  display: block;
  font-size: 21rpx;
}
