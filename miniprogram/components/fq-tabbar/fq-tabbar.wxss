/* components/fq-tabbar/fq-tabbar.wxss
   底部 Tab（总览 / 全部 / 我的）
   规则原在 pages/index/index.wxss 里，整段搬来、一字未改。
   共享资产（自绘图标 .ico-* / 象限图标 .qmark / 按钮 .btn*）留在 app.wxss，
   靠 styleIsolation: apply-shared 生效 —— 所以这里只有本组件自己的骨架。
   ============================================================== */

/* ---------------- 底部 Tab ---------------- */

/* 底部 Tab。
   ⚠️ 高度必须写在 .tb 上，不能写在 .tabbar 上。
   全局 box-sizing 是 border-box，若给 .tabbar 同时设 height:120rpx 与
   padding-bottom: env(safe-area-inset-bottom)，安全区会被从这 120rpx 里「抠掉」：
   iPhone 上 120rpx = 88px、安全区 ≈ 44px，内容区只剩 44px，而
   图标盒(40rpx) + 间距(8rpx) + 文字(20rpx) 需要 50px 以上，图标只能顶出上边框 ——
   那条 border-top 就横穿在图标上（实测图标顶部 y=1107，边框在 y=1111）。
   现在安全区加在 120rpx 之外，内容区永远是完整的 120rpx。 */
.tabbar {
  flex: 0 0 auto;
  display: flex;
  background: #fff;
  border-top: 2rpx solid var(--line);
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

.tb {
  flex: 1;
  height: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: var(--ink3);
}

/* 图标统一装进 40rpx 见方的盒子。
   四个图标本身是 38 / 38 / 30 / 40rpx 不等高，直接居中会让图标和文字各错几 rpx，
   看起来就是「图标没对齐」。 */
.tb .tbi {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tb .lbl {
  margin-top: 8rpx;
  line-height: 1;
}

.tb.on {
  color: var(--ink);
}

