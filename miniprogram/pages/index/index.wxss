/* pages/index/index.wxss
   四象限事项中心 · 移动端
   设计稿：four-quadrant-mobile（375 × 780 画布）
   换算规则：设计稿 px × 2 = rpx（750rpx = 屏宽）
   ------------------------------------------------------------
   布局模型：.screen 是纵向 flex，中间那块（详情/全部/我的用 .scroller，
   总览页用 .ovbody，日程页用 .schedwrap）用 flex:1 吃掉剩余高度。所以底部
   tab / 主按钮是「天然贴底」的，不再依赖 JS 测量屏幕高度 —— 早期版本靠
   scrollerH 撑位置，Android 上 screenHeight 含虚拟导航栏，算出来偏大就会把
   tabbar 顶出屏幕（表现为 tab 不贴底、图标被压扁）。
   总览页由此实现「一屏刚好装完、不滚动」：矩阵自适应撑满、饮水卡按内容高，
   屏幕变矮也只是矩阵变矮（见下方 .ovbody 段）。
   日程页同理，但把「固定」用在月历上：月历不伸不缩，日期头+计划卡+当天事项
   一起在 .schbody 里滚（见下方 .schedwrap 段）。
   ------------------------------------------------------------
   头部固定：详情页的 dhead + filters + sortrow + swipecue、全部页的
   sortrow + swipecue，全部写在 .scroller **之外**，是 .screen 的固定子项
   （flex:0 0 auto）。只有事项列表在滚动区里 —— 列表再长，返回键、
   「调整顺序」按钮与手势提示都不会被滚走。
   加新的头部块时记得两件事：① 放在 <scroll-view class="scroller"> 之前；
   ② 写 flex:0 0 auto，否则默认的 0 1 auto 会在屏幕不够高时把它压扁。
   ------------------------------------------------------------
   滚动的两条铁律（长列表「滑到的卡片是空白」就是踩了它们）：
   ① 静止的行不挂 transform，也不挂裁剪。transform 会把元素提升成独立图层，
      .row 的 overflow:hidden 会再叠一层裁剪层；列表一长，iOS 的重绘跟不上，
      新露出来的卡片就来不及画。所以行位移在 WXML 里是**条件渲染**
      （只有滑开 / 拖动中 / 需要让位时才写 transform，否则写 none），
      裁剪只在滑开的那一行挂（.row.sw）。
   ② 列表滚动的开关（scroll-y）**不在手势中途改**。
      滚动是视图层在 touchmove 那一刻就启动的，setData 关得晚半拍；
      一边滚一边重排卡片，就会出现跳动与空白。
      排序模式下要让「拖」和「滚」共存，做法是把两种手势分派到不同元素上
      —— 拖动只认卡片右侧的 .dh 手柄（它 catch 掉事件，滚动区收不到），
      卡片其余区域照常滚 —— 而不是去动 scroll-y。所以现在 scroll-y 常开。
   ------------------------------------------------------------
   rpx 常量（index.js 的 LAYOUT 里同名保留，仅用于算 FAB 的 bottom 偏移）：
     NAV_H       88   .appbar / .dhead .bar
     CATS_H      88   .catsrow（28 padding-top + 60 内容）
     STATS_H    112   .stats（24 padding-top + 88 内容）
     TAB_H      120   .tb（.tabbar 自身不设高，另加底部安全区）
     BOTTOM_H   134   .bottombar（18 + 88 + 28）
   ------------------------------------------------------------
   拖动排序相关的常量（同样与 LAYOUT 成对）：
     ROW_GAP      16   .row 的 margin-bottom，算换位位移时要带上
     SWIPE_W     240   .rowacts .act 宽 120rpx × 2（完成·撤销 / 删除），两种视图一致
   ============================================================ */

/* ---------------- 页面骨架 ---------------- */

.screen {
  position: fixed;          /* 整屏固定：配合 disableScroll，页面本身不滚动 */
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg);
  overflow: hidden;
}

/* 详情态：状态栏区域也吃象限色（设计稿 render() 里 .screen 换底色） */
.screen.detail-mode {
  background: var(--qc);
}

/* 以下固定高度的块一律「不伸不缩」，剩余空间全部留给 .scroller */
.statusbar {
  flex: 0 0 auto;
  width: 100%;
  background: transparent;
}



/* ---------------- 滚动区 ---------------- */

.scroller {
  /* 吃掉上下所有固定块之外的剩余高度。
     min-height:0 是关键：没有它，flex item 会被内容撑大，滚动失效。 */
  flex: 1 1 auto;
  min-height: 0;
  overflow: hidden;
  padding: 0;
}

/* 不同视图的安全边距（设计稿 16px 左右边距 → 32rpx） */
.body {
  padding: 24rpx 32rpx 0;
}

.body.tight {
  padding: 8rpx 32rpx 0;
}

.body.flush {
  padding: 0;
}

/* ---------------- 总览页主体：一屏装满（不滚动） ----------------
   总览页没有长列表，所以它**不套 scroll-view**，本身作为 .screen 的一个
   flex item 吃掉剩余高度 —— 和 .scroller 是同一个机制，底部 tab 照样天然贴底。
   内部一列：矩阵容器 flex:1（自适应撑满），饮水卡 flex:0 0 auto（按内容高）。
   这样「屏幕刚好装完」是 flex 分配出来的**结果**，不是拿尺子量出来的巧合：
   屏幕变矮 → 矩阵跟着变矮，不会冒出滚动条。
   ⚠️ 两条 min-height:0 都不能省 —— flex item 的 min-height 默认是 auto，
      内容会把容器撑高并顶出屏幕，正好毁掉这条设计。 */
.ovbody {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx;
  overflow: hidden;   /* 兜底：极窄屏下宁可裁掉矩阵底部，也不让它盖住 tabbar */
}

/* 矩阵容器：吃掉除饮水卡外的全部剩余高度。
   它同时也是「矩阵高度算得出来」的前提 —— 组件里的 .grid.fill 是百分比高度，
   需要一个确定高度的父容器才能解析（见 fq-quad.wxss 的自适应段）。 */
.ovgrid {
  flex: 1 1 auto;
  min-height: 0;
  /* 悬浮新建按钮的定位参照系。
     fq-fab 是 virtualHost 组件、没有自己的节点，.fab 直接成为 .ovgrid 的子节点；
     这里不设 relative 的话，它会一路找到 .screen（position:fixed）上去，
     又变回「距屏幕底」的坐标 —— 矮屏上就会压住下面的饮水条（2026-10-09 修的）。
     矩阵高是 flex 分出来的，所以这两个坐标天然跟着矩阵走。 */
  position: relative;
}

/* 饮水卡：不拉伸、也不被压缩（内容就固定那么高），只负责与矩阵拉开间距 */
.ovwater {
  flex: 0 0 auto;
  margin-top: 24rpx;
}


/* ---------------- 日程页（第 2 个 Tab） ---------------- */

/* 与总览页同构：固定块不伸不缩，滚动块 flex:1 吃掉剩余高度。
   这一层之所以存在（而不是直接把 fq-cal / scroll-view 摆进 .screen），
   是为了让「月历固定、其余滚动」这条切分有个明确的归属，
   而不是散在若干兄弟节点上靠顺序暗示。 */
.schedwrap {
  flex: 1 1 auto;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 月历固定在顶部，不随列表滚走 —— 点日期是这一页的核心动作，
   日历被滚走之后想换一天就得先滚回去（见 WXML 里的说明）。 */
.schcal {
  flex: 0 0 auto;
  padding: 24rpx 32rpx 0;
}

/* 日期头 + 两张计划卡 + 当天事项，一起滚。
   min-height:0 与 .scroller 同理：没有它，flex item 会被内容撑大，滚动失效。
   padding 直接写在 scroll-view 上（与设计稿的 .scroller 一致）。 */
.schbody {
  flex: 1 1 auto;
  min-height: 0;
  padding: 0 32rpx 24rpx;
}

/* 选中日那一行：'10月9日 周五' +「今天」胶囊 + 右侧项数 */
.dayh {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx 18rpx;
}

.dayh .d {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
  font-variant-numeric: tabular-nums;
}

.dayh .now {
  margin-left: 16rpx;
  padding: 5rpx 14rpx;
  border-radius: 999rpx;
  background: var(--ink);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
}

/* margin-left:auto 把项数推到最右 —— 中间那个「今天」胶囊出现与否都不影响它 */
.dayh .r {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--ink3);
}

/* 「这天的事项」的分节标题：文字 + 一条拉到右边的细线 */
.dsec {
  display: flex;
  align-items: center;
  padding: 20rpx 4rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0.03em;
  color: var(--ink3);
}

.dsec .ln {
  flex: 1;
  height: 2rpx;
  margin-left: 16rpx;
  background: var(--line);
}

/* 当天事项的一行。圆点直接读全局的 .q1~.q4 —— 那四个类把 --qc 指向象限色，
   所以这里只写「用 --qc」，不必把四种颜色再抄一遍（抄了就会有两份色值）。 */
.minirow {
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx;
  margin-bottom: 14rpx;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  font-size: 25rpx;
}

.minirow .qq {
  flex: 0 0 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--qc, var(--ink3));
}

/* min-width:0：不清掉 flex 的 min-width:auto，长标题会把右侧时刻顶出卡片，
   省略号也永远不生效（与 .qrow .qname 是同一条坑）。 */
.minirow .tt {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.minirow .tt.dn {
  color: var(--ink3);
  text-decoration: line-through;
}

.minirow .pp {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-size: 21rpx;
  font-weight: 600;
  color: var(--ink3);
  font-variant-numeric: tabular-nums;
}

/* 空态：这句话同时是这块内容的说明书（说清「带提醒的」这个口径） */
.dempty {
  display: block;
  padding: 8rpx 4rpx 20rpx;
  font-size: 23rpx;
  color: var(--ink3);
}


/* 「全部」页的象限分段 */
/* 负 margin + 等值 padding：高亮时背景能溢出到卡片两侧一点，不选中时不占额外空间 */
.sec {
  margin: 0 -14rpx;
  padding: 0 14rpx;
  border-radius: 28rpx;
  transition: background 0.18s ease;
}

.sec.drop {
  background: rgba(37, 99, 235, 0.08);
  box-shadow: inset 0 0 0 2rpx rgba(37, 99, 235, 0.35);
}

.sechead {
  display: flex;
  align-items: center;
  margin: 24rpx 0 16rpx;
}

.droptip {
  margin-left: 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--blue);
}

.sdot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 6rpx;
  margin-right: 16rpx;
  flex: 0 0 16rpx;
  background: var(--qc);
}

.sdot.q1 { background: var(--q1); }
.sdot.q2 { background: var(--q2); }
.sdot.q3 { background: var(--q3); }
.sdot.q4 { background: var(--q4); }

.sname {
  font-size: 24rpx;
  font-weight: 600;
}

.scount {
  font-size: 22rpx;
  color: var(--ink3);
  margin-left: 12rpx;
}

/* 手势提示行。固定高度 + 等值 line-height = 文字在这个高度里严格垂直居中，
   ⚠️ 不要用「上下不对称的 padding」来撑高度（原来 padding:4rpx 0 12rpx，
   上 4 下 12，文字明显偏上）。它现在还是固定头部的一员（flex:0 0 auto）。 */
.swipecue {
  flex: 0 0 auto;
  display: block;
  height: 46rpx;
  line-height: 46rpx;
  font-size: 20rpx;
  color: var(--ink3);
  text-align: center;
  letter-spacing: 0.02em;
}

/* 排序入口下面那行提示（只剩详情页 / 全部页两个使用点）改左对齐：
   上一行「拖动卡片…」在 .sortrow 里从 32rpx 起排，这一行必须跟它同一个左边缘，
   否则上左下一中，看着像两块互不相干的东西。
   （总览页那条「矩阵按…」说明已删：那一页现在一屏装满，不留提示行。
     所以 .swipecue 的居中样式当前没有使用点了，留着是因为它描述的是
     「提示行」这个元素的默认形态，删掉反而让 .left 变成不可读的差异。） */
.swipecue.left {
  text-align: left;
  padding: 0 32rpx;
}

/* 详情页这两处文字落在象限色的底上，--ink3 的灰在上面几乎看不清 */
.screen.detail-mode .swipecue,
.screen.detail-mode .sortrow .shint {
  color: rgba(255, 255, 255, 0.72);
}


/* ---------------- 排序模式（详情 / 全部） ----------------
   进入方式：列表上方的「调整顺序」按钮。
   进入后只允许拖动卡片：点卡片不编辑、左滑不展开、筛选与详情菜单被锁，
   底部换成固定的「完成」条，保证随时能退出（列表滚不滚得动都不影响退出）。 */

/* 「调整顺序」行。它现在是固定头部的一员（在 .scroller 之外），
   flex:0 0 auto 必写：不写就是默认的 0 1 auto，屏幕不够高时这一行会被压扁。 */
.sortrow {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 4rpx;
}

.sortrow .shint {
  flex: 1;
  min-width: 0;
  font-size: 21rpx;
  line-height: 1.4;
  color: var(--ink3);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.sbtn {
  flex: 0 0 auto;
  height: 60rpx;
  margin-left: 16rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  border: 2rpx solid var(--line);
  background: #fff;
  color: var(--ink2);
  font-size: 24rpx;
  display: flex;
  align-items: center;
}

.sbtn .ico-sort {
  margin-right: 10rpx;
}


/* 排序模式下的底部固定条（替代底栏 / Tab） */
/* ---------------- 事项卡片（左滑露出操作） ---------------- */

.rows-wrap {
  padding: 20rpx 32rpx 24rpx;
}

.row {
  position: relative;
  border-radius: 24rpx;
  /* ⚠️ 这里刻意不写 overflow:hidden。
     它本来只为一件事服务：把滑开时露出的操作面板按卡片圆角裁掉。
     但常驻裁剪会给每一行在滚动容器里额外造一个裁剪层 —— 列表一长，
     iOS 滚动时新露出来的区域就来不及重绘，表现为「滑到的卡片全是空白」。
     所以裁剪只在真的滑开时挂上（.row.sw），静止行一个裁剪层都不留。 */
  background: var(--line2);
  margin-bottom: 16rpx;
}

/* 只有正被滑开的那一行需要裁剪（操作面板滑到卡片外面去） */
.row.sw {
  overflow: hidden;
}

/* 左滑面板。⚠️ 这层只在「本行正被滑开」时才存在于 DOM（WXML 里靠 swipeKey 判定），
   不是常驻靠 .row-in 遮住的——已完成的行整块半透明，常驻会直接透出来。 */
.rowacts {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  justify-content: flex-end;
}

/* 左滑面板：2 个操作（完成 / 删除）= 240rpx。
   这个数必须与 index.js 的 LAYOUT.SWIPE_W 一致，否则滑开后会露白。 */
.rowacts .act {
  width: 120rpx;
  flex: 0 0 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 22rpx;
}

.rowacts .act .lbl {
  margin-top: 6rpx;
}

.rowacts .ok { background: var(--ok); }
.rowacts .del { background: var(--q1); }

/* 排序模式：操作组已经不渲染（WXML wx:if），但 .row 自己还有一层浅底，
   拖动时卡片一让位就会露出一块灰条。排序期间把它也清掉，只留卡片本身。 */
.row.sorting {
  background: transparent;
}

/* 拖动中的卡片会越出自己那一行的范围，必须抬到同级之上，否则会被后面的卡片盖住。
   （裁剪不用管：.row 平时本来就不裁剪，只有滑开的那一行才临时挂 overflow:hidden。） */
.row.liftrow {
  z-index: 5;
}

.row-in.lift {
  box-shadow: 0 24rpx 56rpx -18rpx rgba(16, 18, 22, 0.45);
  border-color: #cfd5dd;
  z-index: 5;
  /* ⚠️ 只有「正被拖动的那一张」提升为独立图层。
     它每帧都在挪位置，而上面这圈 28px 模糊的阴影如果跟着重绘，
     单帧要重画十几万像素的高斯模糊 —— 中端 Android 上就是肉眼可见的掉帧。
     提升成独立图层后，移动只是合成，阴影不再重绘。
     这跟「静止的行一律不挂 transform」是同一条思路的两面：
     图层很贵，所以只给真正在动的那一个用。 */
  will-change: transform;
}

/* 进入排序模式时的抖动反馈：一次性，提示「已经可以拖了」。
   ⚠️ 两件事必须说清楚：
   1. 抖动只挂在 .row.pulse 上，而 sortPulse 只在点「调整顺序」的那一刻为真
      （JS 里 380ms 后摘掉）。拖动过程中不再抖动 —— 卡片本来就跟着手指走，
      再叠一层抖动，看起来像没抓稳。
   2. 动画只能加在 .tx（卡片内容）上，不能加在 .row-in 上：
      卡片跟手的位置由 .row-in 的内联 transform 承担，
      给同一个元素加 transform 动画会在动画期间把它拽回原位。 */
@keyframes txShake {
  0% { transform: translateX(0); }
  20% { transform: translateX(-5rpx); }
  40% { transform: translateX(5rpx); }
  60% { transform: translateX(-3rpx); }
  80% { transform: translateX(2rpx); }
  100% { transform: translateX(0); }
}

.row.pulse .row-in .tx {
  animation: txShake 0.32s ease-out 1;
}

.row-in {
  position: relative;
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 24rpx;
  padding: 22rpx 24rpx 22rpx 30rpx;
  display: flex;
  align-items: flex-start;
  transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1);
}

/* 左侧 3px 色条：轻量标记象限身份 */
.row-in::before {
  content: "";
  position: absolute;
  left: 0;
  top: 22rpx;
  bottom: 22rpx;
  width: 6rpx;
  border-radius: 0 6rpx 6rpx 0;
  background: var(--qc);
}

.row-in.dragging {
  transition: none;
}

.row-in .tx {
  flex: 1;
  min-width: 0;
}

/* 排序模式：给右侧手柄腾出一条。手柄是绝对定位、不参与 flex，
   不腾地方的话长标题会直接钻到它下面去。72rpx = 手柄 88rpx − 卡片自身右边距 24rpx + 8rpx 间隙 */
.row.sorting .row-in .tx {
  padding-right: 72rpx;
}

/* 拖动手柄（只在排序模式渲染）：拖动排序**只认这里**。
   它是「拖」与「滚」的分界线 —— 手柄 catch 掉 touch 事件，scroll-view 收不到，
   卡片其余区域仍然把手势交给列表，于是排序模式也可以正常滚动。
   宽 88rpx（≈44px）是触控热区下限，高度撑满整张卡片：
   手指落在卡片右侧任意高度都能抓住，不必去瞄那个小图标。 */
.dh {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--ink3);
}

.row-in .t {
  display: block;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: -0.005em;
}

.row-in .n {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 23rpx;
  color: var(--ink3);
  line-height: 1.45;
  margin-top: 4rpx;
}

.row-in .tags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;   /* 不要 stretch：否则各标签被拉到同高，文字却各自顶头 */
  margin-top: 14rpx;
  margin-right: -10rpx;
}

/* 标签：固定高度 + 等值 line-height，中英文混排时文字才会一致垂直居中。
   只靠 padding 撑高时，"P3"（拉丁字母）与"工作分类"（中文）的基线不同，
   视觉上一个偏上、一个居中。 */
.tag {
  display: inline-block;
  height: 36rpx;
  line-height: 36rpx;
  box-sizing: border-box;
  padding: 0 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 10rpx;
  background: var(--line2);
  color: var(--ink2);
  letter-spacing: 0.02em;
  margin-right: 10rpx;
  vertical-align: middle;
}

.tag.pri { background: #fff1f2; color: var(--q1); }
.tag.cat { background: #eff4ff; color: var(--blue); }
.tag.time { background: #ecfdf3; color: #0b7a3c; }

/* ---------------- 事项进度条 ----------------
   轨道 / 横杆 / 填充 / 圆点**整段复用 app.wxss 的共享块**（今日饮水卡同款：
   轨道 14rpx、圆点 32rpx、触区 48rpx）。这里只补三件本卡片自己的事：
   它在卡片里的排版、它读哪个颜色、以及右侧那个读数。 */

.prog {
  display: flex;
  align-items: center;
  margin-top: 14rpx; /* 与 .tags 同一个呼吸节奏 */

  /* ⚠️ 颜色的唯一入口：填充与圆点描边都读 var(--wt)。
     --qc 由 .row 上的 q1~q4 类给出（app.wxss），所以进行中的进度条自然长成
     所属象限的颜色 —— 与左侧色条、详情页底色读的是同一个值。
     改颜色只需要动这一行，两个部件都会跟着走。 */
  --wt: var(--qc, var(--ink3));
}

/* 100% = 完成：只把这一个 token 换成完成绿，填充与圆点自动跟着转。
   ⚠️ 绿色只上到**图形**上。右侧读数保持灰字，100% 时换成对勾 ——
      绿的对比度 3.37:1 够图形（门槛 3:1）但跌破正文门槛（4.5:1），
      把「100%」这四个字符染绿就是本页唯一一处不合规的文字。 */
.prog.full {
  --wt: var(--ok);
}

/* 轨道作为 flex item 占满「读数之外」的剩余宽度。
   min-width:0 不能省：flex 子项的默认 min-width 是 auto，会被内容顶宽。 */
.prog .wtrack {
  flex: 1;
  min-width: 0;
}

/* 读数：固定 68rpx 宽（设计稿 34px）。
   宽度固定是「9% → 100% 位数变化不会把轨道左右推挤」的唯一保证 ——
   WXSS 里 font-variant-numeric 不保证生效，靠固定宽度 + 右对齐顶上。
   换成对勾之后它仍占同样宽度，所以完成那一刻轨道不会突然变长。 */
.rpv {
  flex: 0 0 68rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink3);
}

/* 已完成：只有两件事 —— 标题划掉、整块变淡。
   不再改左侧色条（那是多余的「处理」，用户明确要求去掉）。 */
.row.done .row-in {
  opacity: 0.5;
}

.row.done .row-in .t {
  text-decoration: line-through;
}

/* ---------------- 空态 ---------------- */

.emptystate {
  padding: 88rpx 40rpx;
  text-align: center;
  color: var(--ink3);
}

.emptystate .t {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink2);
  margin-bottom: 8rpx;
}

.emptystate .d {
  display: block;
  font-size: 23rpx;
  line-height: 1.5;
}

.loading-hint {
  padding: 120rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: var(--ink3);
}

/* ---------------- 底部主按钮（详情态） ---------------- */



/* ---------------- 遮罩与抽屉 ---------------- */

.scrim {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(16, 18, 22, 0.42);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
  z-index: 8;
}

.scrim.on {
  opacity: 1;
  pointer-events: auto;
}

/* 抽屉：内容由「头部（固定）+ 主体（封顶可滚）+ 底部按钮（固定）」自然堆叠。
   ⚠️ 不要用 max-height + flex 那套：容器主轴尺寸不确定时，flex 不会收缩子项
   （flex-shrink 只在容器有确定高度时才分配空间），主体会连同内容一起溢出容器盒；
   容器又没有 overflow:hidden、底部按钮区没有背景，于是内容从按钮底下透出来
   （实测截图 546×1077：蓝色按钮 y934..996 与「提醒时间」行叠在一起，
   且该行的下半截画在按钮下面 y1002..1064）。
   正解：主体自己封顶（.sheet-body 的 max-height），抽屉高度 = 三段之和，
   头部与按钮天然固定。 */
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 9;
  transform: translateY(102%);
  /* visibility 兜底：某些端上 input/textarea 不跟随父级 transform，
     收起后仍会残留在屏幕上。visibility 是非连续属性，用 0s 延迟切换：
     打开时立刻可见，关闭时等动画跑完再隐藏。 */
  visibility: hidden;
  transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s 0.38s;
  box-sizing: border-box;
  /* 纯兜底：正常情况下内容不会溢出，一旦溢出宁可裁掉也不要糊在按钮上 */
  overflow: hidden;
  padding: 16rpx 36rpx 0;
}

.sheet.on {
  transform: translateY(0);
  visibility: visible;
  transition: transform 0.38s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s 0s;
}

.handle {
  flex: 0 0 auto;
  width: 76rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #dde1e6;
  margin: 12rpx auto 28rpx;
}

.sheet .h3 {
  flex: 0 0 auto;
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: -0.01em;
  margin: 0 0 4rpx;
}

.sheet .sd {
  flex: 0 0 auto;
  display: block;
  font-size: 23rpx;
  color: var(--ink3);
  margin-bottom: 32rpx;
}

/* 表单滚动区：自己封顶，超出就滚。
   上限 = 88vh − 头部（把手 48 + 标题 45 + 副标题 64 + 抽屉上内边距 16 ≈ 173rpx）
        − 底部操作区（20 + 88 + 28 = 136rpx）− 底部安全区，
   留 20rpx 余量取 330rpx，保证「头部 + 主体 + 按钮」始终不超过 88vh。 */
.sheet-body {
  max-height: 78vh; /* 兜底：万一 calc 里的 env() 不被支持 */
  max-height: calc(88vh - 330rpx - env(safe-area-inset-bottom));
  padding-bottom: 8rpx;
}

/* 抽屉底部固定操作区：不随表单滚动，永远贴在面板底部，
   并把 iOS 底部安全区一起撑开。加不透明背景，
   万一有内容溢出也只会在按钮上方露出一点点，不会糊在按钮下面。 */
.sheet-foot {
  background: #fff;
  padding: 20rpx 0 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}

/* 表单 */

.field {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--ink3);
  letter-spacing: 0.05em;
  margin-bottom: 14rpx;
}

/* 设置项下面那行小字（v8：提前提醒的授权说明）。
   它和 .label 是两种东西 —— 「标签」vs「说明」，所以同色不同压强：
   字号一样，但字重 400（label 是 600）、行高放开。靠字重分层而不是靠层级。 */
.subhint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.55;
  color: var(--ink3);
}

/* input 的高度在小程序里由 font-size 推断，再叠 padding 容易被裁切。
   改成固定高度 + 等值 line-height，文字稳定垂直居中。 */
.input {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  padding: 0 26rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: #fff;
}

/* 同理：总高保持 200rpx，与原来 content-box 下 152 + 上下 padding 48 等价 */
.textarea {
  width: 100%;
  height: 200rpx;
  box-sizing: border-box;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  padding: 20rpx 26rpx;
  font-size: 28rpx;
  color: var(--ink);
  background: #fff;
  line-height: 1.5;
}

.ph {
  color: #b6bdc7;
}

/* 象限选择器（移动端新增能力） */

.qpick {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  padding: 2rpx 8rpx;
}

.qp {
  position: relative;
  border: 4rpx solid transparent;
  border-radius: 22rpx;
  padding: 18rpx 20rpx;
  background: var(--qc);
  color: #fff;
  text-align: left;
}

.qp .qn {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.3;
}

.qp .qh {
  display: block;
  font-size: 20rpx;
  line-height: 1.4;
  letter-spacing: 0.04em;
}

.qp.sel {
  box-shadow: 0 0 0 4rpx #fff, 0 0 0 8rpx var(--qc);
}

.qp .ck {
  position: absolute;
  top: 16rpx;
  right: 18rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #fff;
  color: var(--qc);
  font-size: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 胶囊选择 */

.pills {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: -14rpx;
}

.pill {
  font-size: 25rpx;
  padding: 14rpx 26rpx;
  margin: 0 14rpx 14rpx 0;
  border-radius: 20rpx;
  border: 2rpx solid var(--line);
  background: #fff;
  color: var(--ink2);
  line-height: 1.3;
}

.pill.on {
  background: var(--ink);
  border-color: var(--ink);
  color: #fff;
}

.pill.pri.on {
  background: var(--q1);
  border-color: var(--q1);
}

/* 提醒时间行（日期 / 时间两个 picker） */

.rowline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border: 2rpx solid var(--line);
  border-radius: 22rpx;
  padding: 22rpx 26rpx;
  font-size: 27rpx;
}

.rowline .pick {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rowline .pdate {
  flex: 1;
  min-width: 0;
}

.rowline .ptime {
  flex: 0 0 auto;
}

.rowline .pick.right {
  text-align: right;
  color: var(--ink2);
  display: flex;
  align-items: center;
  /* justify-content: flex-end; */
  width: 120rpx;
}

.rowline .pick.right .ico-chev-r {
  margin-left: 14rpx;
  flex: 0 0 14rpx;
}

/* v8：「提前提醒」那一行整行是 picker，箭头不在 .pick 内部，上面那条挑不到它。
   提取成通用规则而不是再加一条 .pick 变体 —— 箭头只要落在 .rowline 里就该钉死宽度，
   这本来就与它左边装什么无关。 */
.rowline .ico-chev-r {
  margin-left: 14rpx;
  flex: 0 0 14rpx;
}

.rowline .ph {
  color: #b6bdc7;
}

.rowline .clear {
  color: var(--q1);
  font-size: 24rpx;
  padding-left: 24rpx;
  flex: 0 0 auto;
}

/* ---------------- 我的 ---------------- */

.mecard {
  background: #fff;
  border: 2rpx solid var(--line);
  border-radius: 28rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
}

.mecard .h4 {
  font-size: 26rpx;
  font-weight: 600;
  margin: 0 0 4rpx;
}

.mecard .hint {
  display: block;
  font-size: 23rpx;
  color: var(--ink3);
  margin-bottom: 22rpx;
}

.mecard .hint.flat {
  margin-bottom: 0;
}

.catrow {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-top: 2rpx solid var(--line2);
}

.catrow:first-of-type {
  border-top: 0;
}

.catrow .dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 6rpx;
  background: var(--ink3);
  flex: 0 0 18rpx;
  margin-right: 20rpx;
}

.catrow .dot.on {
  background: var(--ink);
}

.catrow .nm {
  flex: 1;
  min-width: 0;
  font-size: 27rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.catrow .ct {
  font-size: 24rpx;
  color: var(--ink3);
  font-variant-numeric: tabular-nums;
}

.catrow.add {
  color: var(--blue);
  font-size: 27rpx;
}

.catrow.add .ico-plus {
  margin-right: 20rpx;
}

.func {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--line2);
  font-size: 27rpx;
}

.func:first-of-type {
  border-top: 0;
}

.func.warn {
  color: var(--q1);
}

.func .arw {
  color: var(--ink3);
  font-size: 28rpx;
}
